# Docker Compose substitutes these into compose.yml. Copy to .env and use unique values.
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
# The OpenAI key stays inside LiteLLM and never reaches the API or agent runtime.
OPENAI_API_KEY=replace-with-your-openai-api-key
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-litellm-master-key
LITELLM_MODEL=agent-model
SEARXNG_SECRET=replace-with-a-long-random-searxng-secret
AGENT_REASONING_EFFORT=medium
# DEBUG prints everything (SQL, HTTP, LLM calls). Use INFO once things are stable.
LOG_LEVEL=DEBUG
# Local HTTP port for Caddy. Use a domain-specific Caddy configuration for TLS.
HTTP_PORT=8080
