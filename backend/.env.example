LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-replace-with-a-long-random-litellm-master-key
LITELLM_MODEL=agent-model
LITELLM_LOCAL_MODEL_COST_MAP=True
AGENT_REASONING_EFFORT=medium
AGENT_RECURSION_LIMIT=100
AGENT_COMPACTION_TOKENS=838860
AGENT_COMPACTION_KEEP_MESSAGES=20
AGENT_SUMMARY_INPUT_TOKENS=32000
# Defaults to DATABASE_URL. A separate durable database may be supplied.
# AGENT_CHECKPOINT_DATABASE_URL=postgresql://user:password@postgres:5432/learning_coach
AGENT_MCP_ENABLED=true
AGENT_MCP_ROLES=Researcher
APP_NAME=Learning Coach API
APP_VERSION=0.4.0
ENVIRONMENT=development
# Comma-separated trusted browser origins. Set your production web origin before deployment.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Persistent data and authentication. For Supabase, use its Session pooler
# connection string (with the asyncpg driver) and Project Connect credentials.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set true only for a local SQLite demo that uses the built-in JWT login.
LOCAL_AUTH=false
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
JWT_SECRET=replace-with-a-random-32-plus-character-secret
APP_ENCRYPTION_KEY=q0_mL9PZ2Ik1Wl9qVzYmIDQDfL8dbbSbix-AJZAcBLk=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Optional JSON object of MCP server connection configurations. When omitted,
# the built-in restricted learning-browser stdio server is used.
# MCP_SERVERS_JSON={"learning-browser":{"transport":"stdio","command":"python","args":["-m","app.browser.server"]}}

# Required safety controls for agent-browser research. The gateway additionally
# validates destinations and enforces its per-run quotas.
AGENT_BROWSER_CONTENT_BOUNDARIES=1
AGENT_BROWSER_MAX_OUTPUT=6000
# Optional trusted argv override for development only. Normal installs resolve
# the pinned project-local agent-browser executable automatically.
# AGENT_BROWSER_COMMAND=agent-browser
