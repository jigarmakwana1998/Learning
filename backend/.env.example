# API settings. Copy to backend/.env. In Docker, compose.yml also sets DATABASE_URL,
# LITELLM_BASE_URL, LITELLM_API_KEY and SEARXNG_URL for the api container.

# Supabase: the Session Pooler connection string (asyncpg driver) and project keys.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
# Server-only. Lets the API promote ADMIN_EMAIL to app_metadata.role=admin on its first request.
SUPABASE_SECRET_KEY=sb_secret_<your-key>
ADMIN_EMAIL=admin@example.com

# Encrypts stored transcripts. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Comma-separated trusted browser origins. Set your production web origin before deployment.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Model gateway, for running the API outside Docker.
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=sk-replace-with-your-litellm-master-key

# Browser MCP server (mcp/browser). It runs inside the API process, so it reads this file.
# Internal SearXNG search; unset falls back to scraping public search pages.
# SEARXNG_URL=http://127.0.0.1:8888
RESEARCH_MAX_SEARCHES=20
RESEARCH_MAX_PAGES=40
RESEARCH_MAX_ACTIONS=60
RESEARCH_MAX_ELAPSED_SECONDS=600
# Optional trusted argv override for development; normally the pinned binary in
# mcp/browser/node_modules is used.
# AGENT_BROWSER_COMMAND=agent-browser
